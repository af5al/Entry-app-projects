# Copy this file to .env and fill in the values.

# Port the site runs on
PORT=3000

# Password for the admin page (/admin.html) where booking requests are read.
# Use a long random string. If empty, the admin page is disabled.
ADMIN_TOKEN=

# Optional: MongoDB connection string (e.g. from MongoDB Atlas).
# If empty, booking requests are saved to data/bookings.json instead.
MONGODB_URI=
